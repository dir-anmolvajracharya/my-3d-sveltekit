{
	"name": "sveltekit-starter-prismic-minimal",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "concurrently \"npm:vite:dev\" \"npm:slicemachine\" --prefix-colors blue,magenta",
		"vite:dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"slicemachine": "start-slicemachine"
	},
	"devDependencies": {
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/ic": "^1.2.4",
		"@iconify-json/simple-icons": "^1.2.96",
		"@slicemachine/adapter-sveltekit": "^0.3.98",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/three": "^0.186.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"postcss": "^8.5.28",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"slice-machine-ui": "^2.21.5",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"typescript-svelte-plugin": "^0.3.52",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0"
	},
	"type": "module",
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.20.0",
		"@fontsource-variable/urbanist": "^5.3.0",
		"@prismicio/client": "^7.22.0",
		"@prismicio/svelte": "^2.2.1",
		"@theatre/core": "^0.7.2",
		"@theatre/studio": "^0.7.2",
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"@threlte/flex": "^2.2.2",
		"@threlte/rapier": "^3.5.0",
		"@threlte/theatre": "^3.2.2",
		"@threlte/xr": "^1.6.1",
		"clsx": "^2.1.1",
		"gsap": "^3.15.0",
		"three": "^0.186.0"
	}
}
